# ==============================================================================
# HookRelay — Production Environment Configuration Template
# ==============================================================================
# Use this template to configure environment variables for cloud deployment
# (e.g., Render, Railway, Fly.io, or standard Docker hosts).
# ==============================================================================

# Core Runtime
NODE_ENV=production
PORT=3000

# ------------------------------------------------------------------------------
# PostgreSQL 16 (Neon.tech Free Tier / Supabase / AWS RDS)
# ------------------------------------------------------------------------------
# Neon requires sslmode=require for secure TLS connections.
# Example: postgresql://[user]:[password]@[endpoint-id].us-east-2.aws.neon.tech/[dbname]?sslmode=require
DATABASE_URL=postgresql://hookrelay_owner:secret_password@ep-cool-service-123456.us-east-2.aws.neon.tech/neondb?sslmode=require

# ------------------------------------------------------------------------------
# Redis 7+ (Redis Cloud / Upstash Free Tier)
# ------------------------------------------------------------------------------
# BullMQ requires dedicated connection with maxRetriesPerRequest: null.
# Cloud providers require TLS: use the 'rediss://' protocol scheme.
# Upstash example: rediss://default:secret_token@us1-flowing-terrapin-30000.upstash.io:6379
# Redis Cloud example: redis://default:secret_token@redis-12345.c256.us-east-1-2.ec2.redns.redis-cloud.com:12345
REDIS_URL=rediss://default:secret_password@us1-flowing-terrapin-30000.upstash.io:6379

# ------------------------------------------------------------------------------
# S3-Compatible Cold Storage (Supabase Storage / Cloudflare R2)
# ------------------------------------------------------------------------------
# Supabase S3 endpoint: https://<project-id>.supabase.co/storage/v1/s3
# Cloudflare R2 endpoint: https://<account-id>.r2.cloudflarestorage.com
AWS_REGION=us-east-1
AWS_ENDPOINT_URL=https://your-project-id.supabase.co/storage/v1/s3
AWS_ACCESS_KEY_ID=your_s3_access_key_id
AWS_SECRET_ACCESS_KEY=your_s3_secret_access_key
S3_ARCHIVE_BUCKET=hookrelay-cold-archives

# Optional: enable cold storage archiver cron background worker (defaults to false)
ARCHIVER_ENABLED=false
ARCHIVER_INTERVAL_MS=86400000

# ------------------------------------------------------------------------------
# Security & Anti-SSRF Protection
# ------------------------------------------------------------------------------
# In production, strict SSRF validation blocks private RFC1918 / loopback / link-local IPs.
# Set strictly to 'false'.
ALLOW_LOCAL_WEBHOOKS=false

# Allowed origin for CORS (Vercel production dashboard URL)
DASHBOARD_URL=https://hookrelay-dashboard.vercel.app

# ------------------------------------------------------------------------------
# Dispatcher & Worker Tuning
# ------------------------------------------------------------------------------
# BullMQ worker concurrency per container instance
WORKER_CONCURRENCY=5

# Maximum events fetched per poll cycle from the outbox table
OUTBOX_BATCH_SIZE=100

# Cooldown period (in milliseconds) before an OPEN circuit breaker attempts HALF_OPEN probe
CIRCUIT_BREAKER_COOLDOWN_MS=60000
