# Entorno de desarrollo local
NODE_ENV=development
PORT=3000

# PostgreSQL 16 (Neon en producción / Docker en local)
DATABASE_URL=postgresql://app_user:app_password@localhost:5432/hookrelay

# Redis (Redis Cloud en producción / Docker en local)
REDIS_URL=redis://localhost:6379

# Almacenamiento S3-Compatible
# Local/CI: AWS Emulator en :9297
# Producción: Supabase Storage S3
AWS_REGION=us-east-1
AWS_ENDPOINT_URL=http://localhost:9297
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
S3_ARCHIVE_BUCKET=hookrelay-cold-archives

# Ruta interna permitida por el guard anti-SSRF para la demo
DEMO_SINK_URL=http://localhost:3000/api/demo/webhook-sink

# Concurrencia del Worker BullMQ
WORKER_CONCURRENCY=5

# Outbox Poller
OUTBOX_BATCH_SIZE=100

# Circuit Breaker (defaults, también configurables por endpoint en DB)
CIRCUIT_BREAKER_COOLDOWN_MS=60000
