{
  "name": "hookrelay-monorepo",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "apps/api",
    "apps/dashboard"
  ],
  "scripts": {
    "dev": "concurrently -n \"API,DASH\" -c \"blue,magenta\" \"npm run start:api\" \"npm run start:dashboard\"",
    "dev:fast": "concurrently -n \"API,DASH\" -c \"blue,magenta\" \"npm run start:api:fast\" \"npm run start:dashboard\"",
    "docker:up": "wsl docker compose up -d",
    "docker:down": "wsl docker compose stop",
    "start:api": "npm --prefix apps/api run start:dev",
    "start:api:fast": "node apps/api/dist/main.js",
    "start:dashboard": "npm --prefix apps/dashboard run dev",
    "clean": "npm --prefix apps/dashboard run clean",
    "lint": "npm --prefix apps/api run lint && npm --prefix apps/dashboard run lint",
    "typecheck": "npm --prefix apps/api run typecheck && npm --prefix apps/dashboard run typecheck",
    "test:unit": "npm --prefix apps/api run test:unit",
    "test:e2e": "npm --prefix apps/api run test:e2e",
    "build": "npm --prefix apps/api run build && npm --prefix apps/dashboard run build",
    "seed": "npm --prefix apps/api run seed",
    "docker:build:api": "docker build -f apps/api/Dockerfile -t hookrelay-api apps/api"
  },
  "devDependencies": {
    "concurrently": "^10.0.7"
  }
}
