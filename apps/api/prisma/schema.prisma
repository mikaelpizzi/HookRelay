generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model api_keys {
  id           String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenant_id    String           @db.Uuid
  name         String           @db.VarChar(100)
  key_prefix   String           @db.VarChar(16)
  key_hash     String           @unique @db.Char(64)
  environment  environment_type @default(PRODUCTION)
  last_used_at DateTime?        @db.Timestamptz(6)
  expires_at   DateTime?        @db.Timestamptz(6)
  revoked_at   DateTime?        @db.Timestamptz(6)
  created_at   DateTime         @default(now()) @db.Timestamptz(6)
  tenants      tenants          @relation(fields: [tenant_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model deliveries {
  id                String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  event_id          String              @db.Uuid
  endpoint_id       String              @db.Uuid
  status            delivery_status     @default(PENDING)
  attempt_count     Int                 @default(0) @db.SmallInt
  max_attempts      Int                 @default(5) @db.SmallInt
  next_retry_at     DateTime?           @db.Timestamptz(6)
  delivered_at      DateTime?           @db.Timestamptz(6)
  created_at        DateTime            @default(now()) @db.Timestamptz(6)
  updated_at        DateTime            @default(now()) @db.Timestamptz(6)
  webhook_endpoints webhook_endpoints   @relation(fields: [endpoint_id], references: [id], onUpdate: NoAction)
  events            events              @relation(fields: [event_id], references: [id], onUpdate: NoAction)
  delivery_attempts delivery_attempts[]

  @@unique([event_id, endpoint_id], map: "uq_event_endpoint_delivery")
}

/// This table is a partition table and requires additional setup for migrations. Visit https://pris.ly/d/partition-tables for more info.
/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model delivery_attempts {
  id                String            @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  delivery_id       String            @db.Uuid
  endpoint_id       String            @db.Uuid
  attempt_number    Int               @db.SmallInt
  is_success        Boolean
  http_status       Int?              @db.SmallInt
  latency_ms        Int
  request_headers   Json
  response_body     String?
  error_code        String?           @db.VarChar(64)
  created_at        DateTime          @default(now()) @db.Timestamptz(6)
  deliveries        deliveries        @relation(fields: [delivery_id], references: [id], onUpdate: NoAction)
  webhook_endpoints webhook_endpoints @relation(fields: [endpoint_id], references: [id], onUpdate: NoAction)

  @@id([id, created_at])
  @@index([endpoint_id, created_at(sort: Desc), is_success, http_status, latency_ms], map: "idx_attempts_endpoint_metrics")
}

model endpoint_environments {
  endpoint_id       String            @db.Uuid
  environment       environment_type
  webhook_endpoints webhook_endpoints @relation(fields: [endpoint_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@id([endpoint_id, environment])
}

model endpoint_topic_subscriptions {
  endpoint_id       String            @db.Uuid
  topic_id          String            @db.Uuid
  created_at        DateTime          @default(now()) @db.Timestamptz(6)
  webhook_endpoints webhook_endpoints @relation(fields: [endpoint_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  event_topics      event_topics      @relation(fields: [topic_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@id([endpoint_id, topic_id])
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model event_topics {
  id                           String                         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenant_id                    String                         @db.Uuid
  name                         String                         @db.VarChar(120)
  description                  String?
  payload_schema               Json                           @default("{\"type\": \"object\"}")
  max_attempts                 Int                            @default(5) @db.SmallInt
  created_at                   DateTime                       @default(now()) @db.Timestamptz(6)
  updated_at                   DateTime                       @default(now()) @db.Timestamptz(6)
  endpoint_topic_subscriptions endpoint_topic_subscriptions[]
  tenants                      tenants                        @relation(fields: [tenant_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  events                       events[]
  topic_environments           topic_environments[]

  @@unique([tenant_id, name], map: "uq_tenant_topic_name")
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model events {
  id              String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenant_id       String           @db.Uuid
  topic_id        String           @db.Uuid
  environment     environment_type
  idempotency_key String           @db.VarChar(128)
  correlation_id  String           @db.VarChar(64)
  payload         Json
  status          event_status     @default(PENDING)
  created_at      DateTime         @default(now()) @db.Timestamptz(6)
  deliveries      deliveries[]
  tenants         tenants          @relation(fields: [tenant_id], references: [id], onUpdate: NoAction)
  event_topics    event_topics     @relation(fields: [topic_id], references: [id], onUpdate: NoAction)

  @@unique([tenant_id, idempotency_key], map: "uq_tenant_idempotency")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model tenants {
  id                String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name              String              @db.VarChar(120)
  slug              String              @unique @db.VarChar(60)
  is_active         Boolean             @default(true)
  created_at        DateTime            @default(now()) @db.Timestamptz(6)
  updated_at        DateTime            @default(now()) @db.Timestamptz(6)
  api_keys          api_keys[]
  event_topics      event_topics[]
  events            events[]
  webhook_endpoints webhook_endpoints[]
}

model topic_environments {
  topic_id     String           @db.Uuid
  environment  environment_type
  event_topics event_topics     @relation(fields: [topic_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@id([topic_id, environment])
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model webhook_endpoints {
  id                           String                         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenant_id                    String                         @db.Uuid
  url                          String
  description                  String?                        @db.VarChar(255)
  signing_secret               String                         @db.VarChar(128)
  is_active                    Boolean                        @default(true)
  circuit_status               circuit_state                  @default(CLOSED)
  consecutive_failures         Int                            @default(0)
  failure_threshold            Int                            @default(5) @db.SmallInt
  circuit_opened_at            DateTime?                      @db.Timestamptz(6)
  created_at                   DateTime                       @default(now()) @db.Timestamptz(6)
  updated_at                   DateTime                       @default(now()) @db.Timestamptz(6)
  deliveries                   deliveries[]
  delivery_attempts            delivery_attempts[]
  endpoint_environments        endpoint_environments[]
  endpoint_topic_subscriptions endpoint_topic_subscriptions[]
  tenants                      tenants                        @relation(fields: [tenant_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
}

enum circuit_state {
  CLOSED
  OPEN
  HALF_OPEN
}

enum delivery_status {
  PENDING
  IN_FLIGHT
  DELIVERED
  RETRYING
  DEAD_LETTER
}

enum environment_type {
  SANDBOX
  PRODUCTION
}

enum event_status {
  PENDING
  DISPATCHED
}
